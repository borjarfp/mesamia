# Copia este fichero a .env.local (ignorado por git) y rellena las claves reales.
# NUNCA hardcodees estas claves en el código fuente ni las subas a git.

# API de Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# API de Tavily — https://app.tavily.com
TAVILY_API_KEY=

# Opcionales: modelos de Gemini a usar (si se omiten, se usan estos mismos valores por defecto).
# GEMINI_MODEL_FLASH=gemini-2.5-flash
# GEMINI_MODEL_PRO=gemini-2.5-pro
