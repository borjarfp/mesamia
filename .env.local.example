# Copia este fichero a .env.local (ignorado por git) y rellena las claves reales.
# NUNCA hardcodees estas claves en el código fuente ni las subas a git.

# API de Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# API de Tavily — https://app.tavily.com
TAVILY_API_KEY=

# Opcionales: modelos de Gemini a usar (si se omiten, se usan estos mismos valores por defecto).
# GEMINI_MODEL_FLASH=gemini-2.5-flash
# GEMINI_MODEL_PRO=gemini-2.5-pro

# Supabase Postgres para el historial de Guardados (Project Settings → Database → Connection string).
# (En Vercel vale también POSTGRES_URL, que inyecta la integración de Supabase.) Si DATABASE_URL no está, se usa el JSON local .data/mesamia-db.json (efímero en Vercel).
# DATABASE_URL = pooler transaccional (puerto 6543); DATABASE_URL_DIRECT = puerto 5432 (migraciones).
DATABASE_URL=
DATABASE_URL_DIRECT=
